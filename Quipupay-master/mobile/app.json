{
  "expo": {
    "name": "Quipupay",
    "slug": "quipupay",
    "version": "1.0.0",
    "orientation": "portrait",
    "icon": "./assets/images/quipupay-icon.png",
    "scheme": "quipupay",
    "userInterfaceStyle": "automatic",
    "android": {
      "adaptiveIcon": {
        "backgroundColor": "#0B2D5B",
        "foregroundImage": "./assets/images/android-icon-foreground.png",
        "backgroundImage": "./assets/images/android-icon-background.png",
        "monochromeImage": "./assets/images/android-icon-monochrome.png"
      },
      "predictiveBackGestureEnabled": false
    },
    "web": {
      "output": "static",
      "favicon": "./assets/images/quipupay-favicon.png"
    },
    "plugins": [
      "expo-router",
      [
        "expo-splash-screen",
        {
          "backgroundColor": "#0B2D5B",
          "image": "./assets/images/quipupay-splash-icon.png",
          "imageWidth": 140
        }
      ],
      "expo-secure-store",
      "expo-sharing",
      [
        "expo-camera",
        {
          "cameraPermission": "Quipupay necesita la cámara para tomar la foto de tu DNI y tu selfie de verificación."
        }
      ],
      [
        "expo-local-authentication",
        {
          "faceIDPermission": "Quipupay usa tu huella o rostro para que ingreses de forma segura."
        }
      ],
      "expo-image"
    ],
    "experiments": {
      "typedRoutes": true,
      "reactCompiler": true
    }
  }
}
