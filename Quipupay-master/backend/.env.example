NODE_ENV=development
PORT=3000
DATABASE_URL=postgresql://quipupay:quipupay@localhost:5432/quipupay
REDIS_URL=redis://localhost:6379
JWT_ACCESS_SECRET=change-me-access
JWT_REFRESH_SECRET=change-me-refresh
APIPERU_TOKEN=
CLOUDFLARE_R2_ACCOUNT_ID=
CLOUDFLARE_R2_ACCESS_KEY_ID=
CLOUDFLARE_R2_SECRET_ACCESS_KEY=
CLOUDFLARE_R2_BUCKET=
RESEND_API_KEY=
# SMS_PROVIDER vacío o "none" = modo demo (el código de SMS se devuelve en la
# respuesta en vez de enviarse). "telnyx" = envío real, requiere
# TELNYX_API_KEY y TELNYX_MESSAGING_PROFILE_ID (TELNYX_FROM_NUMBER queda
# solo de referencia, ver nota abajo).
SMS_PROVIDER=
TELNYX_API_KEY=
TELNYX_FROM_NUMBER=
# El número de arriba debe tener un Messaging Profile asignado en Telnyx
# (Number Settings > Messaging) para poder enviar — un número solo de voz
# no manda SMS. Para destinos internacionales (fuera de EE.UU./Canadá)
# desde un número longcode de EE.UU., Telnyx además exige mandar con un
# remitente alfanumérico (ver ALPHA_SENDER en sms.service.ts) en vez del
# número, atado a este mismo perfil.
TELNYX_MESSAGING_PROFILE_ID=

KYC_PROVIDER=mock
KYC_STORAGE_KEY=change-me-kyc-storage
AWS_REGION=
AWS_ACCESS_KEY_ID=
AWS_SECRET_ACCESS_KEY=

# --- New Relic APM ---
NEW_RELIC_LICENSE_KEY=
NEW_RELIC_APP_NAME=Quipupay Backend (dev)
# Apagador explicito: dejar SIN definir para que el agente se active solo en
# el proceso de la app (segun newrelic.js). NEW_RELIC_ENABLED es reconocida
# directamente por el agente y su valor gana sobre newrelic.js en TODOS los
# procesos node (incluido el CLI de Nest) — por eso nunca se fija en "true"
# aqui, solo sirve como NEW_RELIC_ENABLED=false para apagarlo del todo.
# NEW_RELIC_ENABLED=false
NEW_RELIC_LOG_LEVEL=info
# Solo cuentas EU (license key que empieza con eu01xx):
# NEW_RELIC_HOST=collector.eu01.nr-data.net
APM_DEMO_ENABLED=true
